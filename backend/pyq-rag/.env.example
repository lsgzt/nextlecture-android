# Public Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# NEVER use the publishable/anon key here. This must be a server-only service-role key.
SUPABASE_SERVICE_ROLE_KEY=
# Google AI Studio / Gemini server-side API key. Never ship this in the APK.
GEMINI_API_KEY=
# Optional server-side failover keys tried after quota/auth/rate-limit failures.
GEMINI_API_KEY1=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
GEMINI_API_KEY4=
GEMINI_API_KEY5=
# Primary document extraction model. Keep configurable because model availability changes.
GEMINI_DOCUMENT_MODEL=gemini-3.6-flash
# Gemini embedding model; output dimensionality must remain 768 for the database schema.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768
# Public retry is rate-limited; this remains required for admin ingestion endpoints.
PYQ_ADMIN_TOKEN=
# Optional comma-separated Android app origins; Android clients do not require CORS.
ALLOWED_ORIGINS=https://gndec-pyq-rag-api.vercel.app
# Public API safety limits.
PUBLIC_RATE_LIMIT_PER_MINUTE=60
ASK_RATE_LIMIT_PER_MINUTE=20
# Document and work limits.
MAX_PDF_BYTES=52428800
MAX_PDF_PAGES=1000
MAX_QUESTIONS_PER_PAPER=300
BATCH_MAX=1
# Conservative semantic grouping thresholds.
GROUP_STRONG_THRESHOLD=0.88
GROUP_UNCERTAIN_THRESHOLD=0.78
GROUP_KEYWORD_OVERLAP_MIN=0.25
# Default port for local execution.
PORT=8080
